{
  "name": "@the-virtual-panda/channels",
  "version": "0.1.0",
  "private": true,
  "description": "Publish a blueprint or a top-level doc to a Microsoft Teams channel as one message, edited in place when the file changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Virtual-Panda/eidos-channels.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs && node --test --experimental-strip-types \"test/*.test.ts\"",
    "install-local": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "eidosmd": "link:../eidosmd/cli",
    "esbuild": "^0.28.2",
    "marked": "^18.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
